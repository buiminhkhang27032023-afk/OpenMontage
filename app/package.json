{
  "name": "openmontage-studio",
  "productName": "OpenMontage Studio",
  "version": "0.1.0",
  "description": "Standalone desktop video editor for OpenMontage \u2014 timeline editing, ffmpeg export, and every OpenMontage tool without an AI assistant.",
  "main": "src/main.js",
  "license": "AGPL-3.0",
  "author": "OpenMontage",
  "scripts": {
    "start": "electron .",
    "test:backend": "node test/backend.test.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "test:multitrack": "node test/multitrack.test.js",
    "test:agent": "node test/agent.test.js",
    "test:llm": "node -e \"require('child_process').execFileSync(require('./test/helpers').PY,['test/llm_client_test.py'],{stdio:'inherit'})\"",
    "test:ui": "node test/ui.test.js",
    "test": "npm run -s test:backend && npm run -s test:multitrack && npm run -s test:agent && npm run -s test:llm && npm run -s test:subs && npm run -s test:fixes && npm run -s test:ui",
    "vendor:win": "bash scripts/fetch-win-vendor.sh",
    "test:subs": "node -e \"require('child_process').execFileSync(require('./test/helpers').PY,['test/subtitles_test.py'],{stdio:'inherit'})\"",
    "test:fixes": "node -e \"require('child_process').execFileSync(require('./test/helpers').PY,['test/fixes_test.py'],{stdio:'inherit'})\""
  },
  "build": {
    "appId": "video.openmontage.studio",
    "productName": "OpenMontage Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "openmontage",
        "filter": [
          "app/backend/**",
          "tools/**",
          "lib/**",
          "schemas/**",
          "pipeline_defs/**",
          "styles/**",
          "skills/**",
          "config.yaml",
          "requirements.txt",
          "!**/__pycache__/**",
          "!**/node_modules/**",
          "!.venv/**",
          "!app/dist/**",
          "app/requirements-studio.txt"
        ]
      },
      {
        "from": "../.env.example",
        "to": "openmontage/.env.example"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../../winbuild/vendor/python",
          "to": "python"
        },
        {
          "from": "../../winbuild/vendor/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "portable": {
      "artifactName": "OpenMontage-Studio-win.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
